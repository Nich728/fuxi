# Production settings for deploy/production/compose.yml.
# Copy to .env in this folder (`task prod:init` does it and fills in a random
# database password), then fill in the rest. .env is never committed.

# Cloudflare Access (ADR-0018), from the Zero Trust dashboard.
# Team domain, with https://, e.g. https://yourteam.cloudflareaccess.com
FUXI_ACCESS_TEAM_DOMAIN=
# Access → Applications → your app → Application Audience (AUD) Tag (64 hex characters)
FUXI_ACCESS_AUD=
# This email's account gets the owner role when it's first created. Optional.
FUXI_OWNER_EMAIL=

# Cloudflare Tunnel token: Networks → Tunnels → your tunnel. SECRET: it lets
# anyone run your tunnel. Paste it here only, never into chats or commits.
TUNNEL_TOKEN=

# Database password. Hex only, so it needs no escaping in a URL. Generated by
# `task prod:init`; changing it later also needs ALTER USER in Postgres.
POSTGRES_PASSWORD=

# Optional
# Where the downloaded datasets are (task data:download), for `task prod:import`.
# FUXI_DATA_DIR=D:/fuxi-data
# Where nightly dumps go, and how many days to keep.
# FUXI_BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# Loopback port for checks on this machine: curl http://localhost:8090/healthz
# FUXI_LOCAL_PORT=8090
# FUXI_LOG_LEVEL=info
